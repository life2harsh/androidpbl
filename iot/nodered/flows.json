  "type": "function",
  "z": "tab",
  "name": "view",
  "func": "const r = msg.payload;\nmsg.payload = {src: `/scans/${r.sid}/last.jpg?t=${Date.now()}`, caption: r.found ? `${r.cls} found \u00b7 ${Math.round(r.score*100)}% \u00b7 ${Math.round((r.cx-0.5)*66)}\u00b0 off centre` : `searching for ${r.cls}\u2026`, bad: !r.found};\nreturn msg;",
