  "wires": []
 },
 {
  "id": "inVer",
  "type": "mqtt in",
  "z": "tab",
  "name": "verdicts",
  "topic": "rover/verdict",
  "qos": "1",
  "datatype": "json",
  "broker": "broker",
  "nl": false,
  "rap": true,
  "rh": 0,
  "inputs": 0,
  "x": 120,
  "y": 440,
  "wires": [
   [
    "fVer",
    "fImg"
   ]
  ]
 },
 {
  "id": "fVer",
  "type": "function",
  "z": "tab",
  "name": "history",
  "func": "const v = msg.payload;\nconst rows = context.get('rows') || [];\nrows.unshift({time: new Date(v.ts * 1000).toLocaleTimeString(), patrol: v.pid, cp: v.cp, verdict: v.verdict, regions: v.regions.length, changed: v.changed === null ? '' : v.changed + '%', ssim: v.ssim === null ? '' : v.ssim});\ncontext.set('rows', rows.slice(0, 40));\nreturn {payload: rows.slice(0, 40)};",
  "outputs": 1,
  "x": 300,
  "y": 440,
  "wires": [
   [
    "table"
   ]
  ]
 },
 {
  "id": "table",
  "type": "ui-table",
  "z": "tab",
  "name": "verdicts",
  "group": "gPatrol",
  "order": 4,
  "width": 6,
  "height": 6,
  "maxrows": 8,
  "passthru": false,
  "autocols": true,
  "showSearch": false,
  "selectionType": "none",
  "columns": [],
  "mobileBreakpoint": "sm",
  "mobileBreakpointType": "defaults",
  "action": "replace",
  "className": "",
  "x": 500,
  "y": 440,
  "wires": []
 },
 {
  "id": "fImg",
  "type": "function",
  "z": "tab",
  "name": "image",
  "func": "const v = msg.payload;\nconst f = v.verdict === 'BASELINE' ? 'f_00001.jpg' : 'diff.jpg';\nmsg.payload = {src: `/scans/${v.pid}-cp${v.cp}/${f}?t=${Date.now()}`, caption: `${v.pid} \u00b7 checkpoint ${v.cp} \u00b7 ${v.verdict}`, bad: v.verdict === 'REVIEW'};\nreturn msg;",
  "outputs": 1,
  "x": 300,
  "y": 480,
  "wires": [
   [
    "img"
   ]
  ]
 },
 {
  "id": "img",
  "type": "ui-template",
  "z": "tab",
  "group": "gPatrol",
  "page": "",
  "ui": "",
  "name": "latest",
  "order": 3,
  "width": 6,
  "height": 4,
  "head": "",
  "format": "<template>\n  <div v-if=\"msg && msg.payload\">\n    <img :src=\"msg.payload.src\" style=\"width:100%;border-radius:6px\">\n    <div :style=\"{color: msg.payload.bad ? '#f85149' : '#2ea043', marginTop: '6px'}\">{{ msg.payload.caption }}</div>\n  </div>\n  <div v-else style=\"color:#8b949e\">No checkpoint yet</div>\n</template>",
  "storeOutMessages": true,
  "passthru": false,
  "resendOnRefresh": true,
  "templateScope": "local",
  "className": "",
  "x": 500,
  "y": 480,
  "wires": [
   []
  ]
 },
