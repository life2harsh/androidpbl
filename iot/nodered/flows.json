 {
  "id": "inTel",
  "type": "mqtt in",
  "z": "tab",
  "name": "telemetry",
  "topic": "rover/telemetry",
  "qos": "0",
  "datatype": "json",
  "broker": "broker",
  "nl": false,
  "rap": true,
  "rh": 0,
  "inputs": 0,
  "x": 120,
  "y": 80,
  "wires": [
   [
    "split"
   ]
  ]
 },
 {
  "id": "split",
  "type": "function",
  "z": "tab",
  "name": "split",
  "func": "const p = msg.payload;\nconst cm = v => v >= 0 ? Math.round(v / 10) : null;\nreturn [\n  {payload: cm(p.front)},\n  {payload: cm(p.rear)},\n  {payload: p.hdg === null ? 'gyro offline' : p.hdg.toFixed(1) + '\u00b0'},\n  {payload: p.patrol},\n  [{topic: 'front', payload: cm(p.front)}, {topic: 'rear', payload: cm(p.rear)}].filter(m => m.payload !== null)\n];",
  "outputs": 5,
  "x": 300,
  "y": 80,
  "wires": [
   [
    "gFront"
   ],
   [
    "gRear"
   ],
   [
    "tHdg"
   ],
   [
    "tState"
   ],
   [
    "chart"
   ]
  ]
 },
